# PostgreSQL connection used by Prisma and the application.
DATABASE_URL=postgresql://yckx_app:replace-me@127.0.0.1:5432/yckx

# Generate a unique high-entropy value for every environment.
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Required in production. Use an absolute path on persistent NAS storage.
UPLOAD_DIR=/volume1/docker/yckx/uploads

# Optional Giscus integration for public article comments.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Required only when explicitly running `pnpm db:seed`.
SEED_ADMIN_EMAIL=admin@example.edu.cn
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-unique-password
SEED_INVITE_CODE=replace-with-a-unique-invite-code
